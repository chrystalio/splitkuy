# Version control
.git
.gitignore

# Dependencies (installed fresh inside the build image)
node_modules
bun.lock
pnpm-lock.yaml
pnpm-workspace.yaml

# Next.js build output
.next
out

# Tests / coverage
coverage

# Docs (not needed at runtime, keeps context small)
docs

# Local environment — never bake secrets into an image
.env*
.env.local
.env.*.local

# Claude tooling
.claude
.superpowers

# OS / editor junk
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts
